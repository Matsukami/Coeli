{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coeli.invalid/contracts/v1/registration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "enum": [
          "development.v1",
          "database.v1",
          "infrastructure.v1",
          "audit.v1",
          "verification.v1",
          "telemetry.v1"
        ]
      }
    },
    "environment": {
      "enum": [
        "laboratory",
        "staging"
      ]
    }
  },
  "required": [
    "name",
    "capabilities",
    "environment"
  ],
  "additionalProperties": false
}
