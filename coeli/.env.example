# Acrescente ao ambiente do backend PentAGI. Sem credenciais neste arquivo.
COELI_ENABLED=true
# Caminhos absolutos dentro da instalação; ajuste antes de iniciar.
COELI_ROOT=/opt/pentagi/coeli
COELI_RUNTIME=/var/lib/pentagi/coeli
# Produção e GPT Cyber não possuem opção de habilitação nesta versão.
